    <!-- Session Strings extracted -->
    <string name="unlock_request_title">Are you sure you want to unlock early?</string>
    <string name="unlock_request_description">Ending your session early requires an OTP sent to your trusted contact, followed by a 10-minute cooldown.</string>
    <string name="unlock_cooldown_title">Unlock Approved</string>
    <string name="unlock_cooldown_description">A 10-minute cooldown period has started. You will be able to access all content once the countdown reaches zero.</string>
    <string name="unlock_cooldown_unlocks_at">Unlocks at: %1$s</string>
    <string name="otp_entry_sent_message">We sent a code to your trusted contact.</string>
    <string name="otp_entry_instruction">Enter the 6-digit code below to approve the early unlock.</string>
    <string name="emergency_bypass_description">Emergency bypass allows you to end the session immediately without a trusted contact, but you will be blocked from starting a new session for 24 hours.</string>
