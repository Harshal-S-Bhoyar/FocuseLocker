<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FocusLock</string>
    
    <!-- Accessibility Service -->
    <string name="accessibility_service_description">FocusLock monitors browser URLs to block distracting content during active focus sessions. This service only reads browser address bars and does not access any other app data.</string>
    
    <!-- Device Admin -->
    <string name="device_admin_description">FocusLock requires Device Admin permission to prevent uninstallation during active focus sessions. This ensures you cannot bypass your own commitment.</string>
    <string name="device_admin_disable_blocked">You cannot disable FocusLock device admin while a focus session is active. Please complete or unlock your session first.</string>
    
    <!-- Permissions -->
    <string name="permission_accessibility_title">Accessibility Service</string>
    <string name="permission_accessibility_description">Required to detect and block keywords in browser URLs across all browsers</string>
    
    <string name="permission_vpn_title">VPN Service</string>
    <string name="permission_vpn_description">Required to block entire domains by category. This is a local VPN - no data leaves your device</string>
    
    <string name="permission_device_admin_title">Device Administrator</string>
    <string name="permission_device_admin_description">Required to prevent app uninstallation during active sessions</string>
    
    <string name="permission_overlay_title">Display Over Other Apps</string>
    <string name="permission_overlay_description">Required to show blocking screens when restricted content is detected</string>
    
    <string name="permission_battery_title">Battery Settings</string>
    <string name="permission_battery_description">Recommended: review battery settings if your device stops FocusLock in the background</string>

    <string name="permission_notification_title">Session Notifications</string>
    <string name="permission_notification_description">Recommended so the active session countdown remains visible while FocusLock is running</string>
    
    <!-- Notification -->
    <string name="notification_channel_name">Active Session</string>
    <string name="notification_channel_description">Shows when a focus session is active</string>
    <string name="notification_title">Focus Session Active</string>
    <string name="notification_text">Time remaining: %s</string>
    <string name="notification_remaining_hours">%1$d h %2$d m</string>
    <string name="notification_remaining_minutes">%1$d m</string>
    <string name="notification_remaining_less_than_minute">less than a minute</string>
    <string name="notification_expired">session expired</string>

    <!-- Onboarding screen -->
    <string name="onboarding_title">Take back control of your focus</string>
    <string name="onboarding_subtitle">Block distracting content for a set time — and genuinely stick to it.</string>
    <string name="onboarding_description">Once a session starts, you cannot stop it alone. Your trusted contact holds the key.</string>
    <string name="onboarding_get_started">Get Started</string>

    <!-- Permission setup screen -->
    <string name="permission_setup_title">Grant Permissions</string>
    <string name="permission_setup_subtitle">FocusLock needs these permissions to block content reliably. Each one is explained below.</string>
    <string name="permission_required_badge">Required</string>
    <string name="permission_grant_button">Grant</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_grant_required">Grant required permissions to continue</string>

    <!-- Trusted contact setup screen -->
    <string name="trusted_contact_title">Register Your Trusted Contact</string>
    <string name="trusted_contact_description">This person will receive an OTP when you request early unlock. Choose someone who will hold you accountable.</string>
    <string name="trusted_contact_email_label">Email Address</string>
    <string name="trusted_contact_email_placeholder">trusted@example.com</string>
    <string name="trusted_contact_email_hint">Must be a valid email address</string>
    <string name="trusted_contact_send_otp">Send Verification OTP</string>
    <string name="trusted_contact_privacy_note">This email is only used to send unlock OTPs. It is never stored on our servers permanently.</string>

