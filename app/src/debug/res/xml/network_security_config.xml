<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for DEBUG builds only.
    This file allows plain HTTP (cleartext) traffic to localhost/127.0.0.1
    so the app can reach the local Node.js backend via ADB reverse tunnel.
    This config is NEVER included in release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 127.0.0.1 is used when testing on a physical device via ADB reverse -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 10.0.2.2 is the Android emulator loopback address (kept as fallback) -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- localhost as a plain hostname -->
        <domain includeSubdomains="false">localhost</domain>
        <!-- Local Wi-Fi IP for physical device testing -->
        <domain includeSubdomains="false">192.168.41.113</domain>
    </domain-config>
</network-security-config>
